# =============================================================================
# Copy to `.env` and fill in from your Supabase project settings.
# `.env` is gitignored; never commit real credentials.
# =============================================================================

# NestJS API; frontend dev server uses port 3000.
PORT=3001

# Supabase transaction pooler (port 6543). Used by the NestJS app at runtime.
# pgbouncer=true disables prepared statements, which Prisma needs on the pooler.
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase direct connection (port 5432). Used by `prisma migrate` only: the
# pooler cannot carry session-level statements that migrations need.
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@<region>.pooler.supabase.com:5432/postgres"

# Platform commission in basis points (500 = 5.00%). Defaults to 500 in code.
APP_COMMISSION_BPS=500

# -----------------------------------------------------------------------------
# HTTP API (docs/Spectification/TNCWebPlatform/06_Backend.md - muc 6.10)
# -----------------------------------------------------------------------------

# Supabase project URL. Bearer tokens are verified against
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json (ES256/RS256 signing keys).
SUPABASE_URL="https://<project-ref>.supabase.co"

# Only for projects that still sign access tokens with the legacy HS256 shared
# secret. Leave empty when using asymmetric signing keys.
SUPABASE_JWT_SECRET=""

# Browser origins allowed by CORS, comma-separated. "*" allows any origin
# (development only).
CORS_ORIGINS="http://localhost:3000"

# Reported by GET /health; the release pipeline sets the real value.
APP_VERSION="0.0.0"

# How long a successful Idempotency-Key response stays replayable (hours).
IDEMPOTENCY_TTL_HOURS=24

# -----------------------------------------------------------------------------
# Shopee sync (docs/backend/SHOPEE_SHOWROOM_BACKEND.md)
# -----------------------------------------------------------------------------

# Provider đồng bộ: csv (MVP - upload file export) | affiliate | open_platform (S4/S5).
SHOPEE_SYNC_PROVIDER=csv

# Gian hàng Shopee của TNC (số trong URL shopee.vn/shop/{id}).
# Dùng khi import file mà không gửi kèm field shopeeShopId.
SHOPEE_SHOP_ID=""

# Tên gian hàng; chỉ dùng khi shop được tạo lần đầu.
SHOPEE_SHOP_NAME=""

SHOPEE_REGION=vn

# Storefront dùng để dựng deep-link "Mua trên Shopee" (shopee.vn cho VN).
SHOPEE_STOREFRONT_URL="https://shopee.vn"

# Query nối vào deep-link mặc định để Seller Center thấy traffic từ showroom.
# KHÔNG áp cho sản phẩm có buyUrlOverride (link affiliate giữ nguyên).
SHOPEE_BUY_URL_SUFFIX="?utm_source=tnc_showroom"

# Item không còn thấy trong nguồn sync quá số ngày này thì bị ẩn khỏi showroom.
SHOPEE_ITEM_HIDE_AFTER_DAYS=7
# Shopee Affiliate Open API (chỉ cần khi SHOPEE_SYNC_PROVIDER=affiliate).
# Đặt secrets trong .env/secret manager, không commit.
SHOPEE_AFFILIATE_APP_ID=
SHOPEE_AFFILIATE_SECRET=
SHOPEE_AFFILIATE_ENDPOINT=https://open-api.affiliate.shopee.vn/graphql
SYNC_AFFILIATE_INTERVAL_MS=14400000

# Facebook Page + Instagram Professional account linked to the Page.
# Use a long-lived Page access token with pages_read_engagement and instagram_basic.
# Keep the token in server-side environment/secret manager only.
META_ACCESS_TOKEN=
META_FACEBOOK_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
META_GRAPH_VERSION=v26.0

# -----------------------------------------------------------------------------
# Catalog & analytics (S3)
# -----------------------------------------------------------------------------

# Origin công khai của API, dùng cho `buyPath` trong response catalog.
# Để trống khi frontend gọi cùng origin (dev: http://localhost:3000).
PUBLIC_API_ORIGIN=""

# Salt cho hash IP/user-agent trong OutboundClick. Đặt giá trị riêng ở production.
ANALYTICS_HASH_SALT="tnc-local-salt"
